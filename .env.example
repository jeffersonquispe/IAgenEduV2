# Copiar a .env y completar con valores reales. Nunca commitear .env.

# --- AWS / Amazon Bedrock ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# Modelo de Bedrock a usar para generación
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Modelo económico de la validación de contenido con IA (default: Haiku 4.5). AWS retira versiones antiguas;
# si falla con 'end of its life' o 'AccessDenied', elige otro disponible en tu cuenta de Bedrock.
# BEDROCK_VALIDATION_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# HU-34: máximo de llamadas a Bedrock en vuelo a la vez (default 4; sube según la cuota de tu cuenta/modelo)
# BEDROCK_MAX_CONCURRENCY=4

# --- Supabase (base de datos + autenticación, app activa: FastAPI + React) ---
# Project Settings -> API en el dashboard de Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# HU-20: segunda barrera de verificación de correo. La verificación real la hace Supabase
# (Authentication > Sign In / Providers > Email > "Confirm email"). Activa esto SOLO si ese
# ajuste está encendido; con él apagado, los usuarios nuevos quedarían sin acceso.
# REQUIRE_VERIFIED_EMAIL=true

# Project Settings -> Database -> Connect -> "Session pooler" (no Direct, no
# Transaction pooler — este backend es un proceso persistente con su propio
# pool de conexiones). Prefijo de driver: postgresql+psycopg://
# Si la contraseña tiene caracteres especiales, hay que URL-encodearla
# (ej. "/" -> "%2F").
DATABASE_URL=

# --- Placeholder para uso futuro (no usado por el código actual) ---
SUPABASE_SERVICE_ROLE_KEY=
