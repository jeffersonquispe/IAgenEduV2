# Copiar a .env y completar con valores reales. Nunca commitear .env.

# --- AWS / Amazon Bedrock ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# Modelo de Bedrock a usar para generación
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# --- Autenticación (app activa: FastAPI + React) ---
# Obligatoria. Sin esta variable, la app rehúsa arrancar (HU-21) — no hay
# valor por defecto en el código para evitar tokens JWT falsificables.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Si SECRET_KEY se rota en un ambiente ya en uso, todas las sesiones activas
# (tokens JWT ya emitidos) quedan invalidadas — los usuarios deben volver a
# iniciar sesión.
